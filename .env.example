# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real API keys.
# All settings are optional; the values below are the defaults from app/config.py.
# Every app setting uses the FT_ prefix (pydantic-settings, case-insensitive).

# --- Paths ---------------------------------------------------------------------------------
# In Docker these are fixed by docker-compose.yml (/evidence, /data, /symbols) and the values
# here are ignored. Set them only when running uvicorn directly on your machine, e.g.:
#   FT_EVIDENCE_DIR=./evidence  FT_DATA_DIR=./data  FT_SYMBOLS_DIR=./symbols
# Read-only directory containing RAM images.
#FT_EVIDENCE_DIR=/evidence
# Writable: SQLite DB (forensics.db), raw tool output (runs/), dumped files.
#FT_DATA_DIR=/data
# Writable: volatility3 symbol cache.
#FT_SYMBOLS_DIR=/symbols

# --- Job worker / volatility3 --------------------------------------------------------------
# Max concurrent tool runs. volatility is memory hungry; keep at 1 unless you have lots of RAM.
FT_MAX_CONCURRENT_RUNS=1
# Default per-run timeout in seconds (the process group is killed afterwards). A plugin catalog
# entry can set its own timeout_seconds.
FT_RUN_TIMEOUT_SECONDS=3600
# Disk protection (bytes). New runs are refused, and queued runs wait, while free space on the
# data volume is below FT_MIN_FREE_DISK_BYTES (default 5 GiB) or the data folder is larger than
# FT_MAX_DATA_BYTES (0 = no cap). A running run is stopped below FT_HARD_MIN_FREE_DISK_BYTES
# (default 1 GiB) to protect the database.
FT_MIN_FREE_DISK_BYTES=5368709120
FT_MAX_DATA_BYTES=0
FT_HARD_MIN_FREE_DISK_BYTES=1073741824
# Stall watchdog: give up on a run with no progress for this many seconds (0 = off).
FT_RUN_STALL_SECONDS=600
# Backups (python -m app.backup). FT_BACKUP_DIR is fixed to /backups in Docker. Automatic
# backup every N hours (0 = off), keeping the newest FT_BACKUP_KEEP automatic ones.
#FT_BACKUP_DIR=/backups
FT_BACKUP_INTERVAL_HOURS=24
FT_BACKUP_KEEP=7
# Executable used to invoke volatility3 (on PATH in the Docker image).
FT_VOL_EXECUTABLE=vol
# Audit log detail: changes | key_reads | all. TEMPORARY default "all" logs every page/API
# request too; the intended long-term setting is key_reads.
FT_AUDIT_LEVEL=all
# Evidence integrity: strict (block runs on changed/mismatching images) | warn (run, but flag it)
FT_INTEGRITY_MODE=strict
# Re-hash the whole image before every run (slow for big images); default is a size/mtime check.
FT_VERIFY_ON_RUN=false
# Dumped files (derived artifacts): per-run size limit in bytes (default 2 GiB) and the password
# of the encrypted zip they are downloaded in.
FT_MAX_ARTIFACT_BYTES=2147483648
FT_ARTIFACT_ZIP_PASSWORD=infected
# Full-text search index for result rows (new runs only): faster search on huge runs, ~2x storage.
FT_SEARCH_INDEX=false
# Post-run hooks (plugin post-processing). Follow-ups are runs queued automatically by hooks.
FT_HOOKS_ENABLED=true
FT_HOOK_FOLLOWUPS_ENABLED=true
FT_HOOK_MAX_CHAIN_DEPTH=2
FT_HOOK_MAX_FOLLOWUPS_PER_RUN=10
# Comma-separated extensions ignored when scanning ./evidence (README, hash files, archives...).
# FT_EVIDENCE_EXCLUDE_EXTENSIONS=.md,.txt,.rst,.pdf,.html,.json,.csv,.log,.ini,.yml,.yaml,.md5,.sha1,.sha256,.sha512,.sig,.asc,.zip,.7z,.rar,.gz,.bz2,.xz,.tar,.tgz
# Pass --offline to volatility3: no Microsoft symbol downloads (pre-fill the symbols volume first).
FT_VOL_OFFLINE=false

# --- AI provider (any OpenAI-compatible /v1 API) -------------------------------------------
# Examples:
#   OpenAI:                        https://api.openai.com/v1
#   Ollama on the Docker host:     http://host.docker.internal:11434/v1
#   (from inside the container "localhost" is the container itself, not your PC)
FT_AI_BASE_URL=http://localhost:11434/v1
# API key / bearer token. Leave empty for providers that don't need one (e.g. Ollama).
FT_AI_API_KEY=
FT_AI_MODEL=gpt-4o-mini
FT_AI_TEMPERATURE=0.2
FT_AI_MAX_TOKENS=2000
# Request timeout in seconds.
FT_AI_TIMEOUT_SECONDS=120
# AI agent ("give the AI a goal"): how it calls its tools. auto = OpenAI function calling,
# falling back to a text protocol if the provider/model does not support tools; native; text.
FT_AI_TOOL_MODE=auto
# Default limits per agent task (the analyst can change them per task). These and
# FT_AI_TOOL_MODE can also be changed on the Settings page (saved values override these).
FT_AGENT_MAX_STEPS=12
FT_AGENT_MAX_SECONDS=600
FT_AGENT_MAX_CONCURRENT=2
# Plugin runs one agent task may queue (each needs approval unless "yes to all"; 0 = read-only).
FT_AGENT_MAX_RUNS=5

# --- Docker Compose only (not read by the app) ---------------------------------------------
# Memory limit for the app container (volatility needs a few GB for large images).
#FT_MEM_LIMIT=8g
