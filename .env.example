# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real API keys.
# All settings are optional; the values below are the defaults from app/config.py.
# Every app setting uses the FT_ prefix (pydantic-settings, case-insensitive).

# --- Paths ---------------------------------------------------------------------------------
# In Docker these are fixed by docker-compose.yml (/evidence, /data, /symbols) and the values
# here are ignored. Set them only when running uvicorn directly on your machine, e.g.:
#   FT_EVIDENCE_DIR=./evidence  FT_DATA_DIR=./data  FT_SYMBOLS_DIR=./symbols
# Read-only directory containing RAM images.
#FT_EVIDENCE_DIR=/evidence
# Writable: SQLite DB (forensics.db), raw tool output (runs/), dumped files.
#FT_DATA_DIR=/data
# Writable: volatility3 symbol cache.
#FT_SYMBOLS_DIR=/symbols

# --- Job worker / volatility3 --------------------------------------------------------------
# Max concurrent tool runs. volatility is memory hungry; keep at 1 unless you have lots of RAM.
FT_MAX_CONCURRENT_RUNS=1
# Per-run timeout in seconds (the process group is killed afterwards).
FT_RUN_TIMEOUT_SECONDS=3600
# Executable used to invoke volatility3 (on PATH in the Docker image).
FT_VOL_EXECUTABLE=vol
# Post-run hooks (plugin post-processing). Follow-ups are runs queued automatically by hooks.
FT_HOOKS_ENABLED=true
FT_HOOK_FOLLOWUPS_ENABLED=true
FT_HOOK_MAX_CHAIN_DEPTH=2
FT_HOOK_MAX_FOLLOWUPS_PER_RUN=10
# Comma-separated extensions ignored when scanning ./evidence (README, hash files, archives...).
# FT_EVIDENCE_EXCLUDE_EXTENSIONS=.md,.txt,.rst,.pdf,.html,.json,.csv,.log,.ini,.yml,.yaml,.md5,.sha1,.sha256,.sha512,.sig,.asc,.zip,.7z,.rar,.gz,.bz2,.xz,.tar,.tgz
# Pass --offline to volatility3: no Microsoft symbol downloads (pre-fill the symbols volume first).
FT_VOL_OFFLINE=false

# --- AI provider (any OpenAI-compatible /v1 API) -------------------------------------------
# Examples:
#   OpenAI:                        https://api.openai.com/v1
#   Ollama on the Docker host:     http://host.docker.internal:11434/v1
#   (from inside the container "localhost" is the container itself, not your PC)
FT_AI_BASE_URL=http://localhost:11434/v1
# API key / bearer token. Leave empty for providers that don't need one (e.g. Ollama).
FT_AI_API_KEY=
FT_AI_MODEL=gpt-4o-mini
FT_AI_TEMPERATURE=0.2
FT_AI_MAX_TOKENS=2000
# Request timeout in seconds.
FT_AI_TIMEOUT_SECONDS=120

# --- Docker Compose only (not read by the app) ---------------------------------------------
# Memory limit for the app container (volatility needs a few GB for large images).
#FT_MEM_LIMIT=8g
