# The team works on Windows but the image runs Linux: normalize to LF in the repo and in
# working trees so shell scripts, Dockerfiles and Python files never get CRLF.
* text=auto eol=lf

*.py         text eol=lf
*.sh         text eol=lf
*.toml       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.html       text eol=lf
*.md         text eol=lf
Dockerfile   text eol=lf
Makefile     text eol=lf
.env.example text eol=lf

# Windows-only scripts keep CRLF.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Binary / vendored.
*.png        binary
*.jpg        binary
*.ico        binary
*.gz         binary
*.xz         binary
*.zip        binary
*.min.js     -diff linguist-vendored
